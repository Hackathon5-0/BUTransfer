{
  "name": "transfer-credit-api",
  "version": "1.0.0",
  "description": "Transfer-credit evaluation API: Node.js service layer over Supabase (Postgres + Auth).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "engine:check": "node scripts/engine-check.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "samples": "python ../make_demo_transcripts.py",
    "test:local": "DOTENV_CONFIG_PATH=.env.test node --test --test-concurrency=1 test/*.test.js",
    "dev:local": "DOTENV_CONFIG_PATH=.env.test node --watch src/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "multer": "^2.5.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
