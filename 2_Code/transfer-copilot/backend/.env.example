# ---------------------------------------------------------------------------
# Transfer Credit API — environment configuration
# Copy to .env and fill in the secret values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Supabase project (Project Settings → API). The URL and the publishable/anon key are
# public values; they are prefilled for the hackathon project.
SUPABASE_URL=https://srehqamxvolzvosdpzej.supabase.co
SUPABASE_ANON_KEY=sb_publishable_z-3fPH8V3MnsclvzCx5PXA_5bACERG8

# SERVER-SIDE SECRET. Service-role ("secret") key, used only by `npm run db:seed` to create the
# demo users in Supabase Auth. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNyZWhxYW14dm9senZvc2RwemVqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5Mjk5NDcwOCwiZXhwIjoyMTA4NTcwNzA4fQ.n7m2xv5uhWpLtiJ_hFLBNJp1rAdLySUxNJ5-sDfwHfs 

# SERVER-SIDE SECRET. Postgres connection string (Project Settings → Database → Connection string).
# Use the Session pooler URI if your network has no IPv6, e.g.
# postgresql://postgres.srehqamxvolzvosdpzej:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:Yh8VWi6shUhIAy9W@db.srehqamxvolzvosdpzej.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Authentication provider: `supabase` (always, in any real deployment).
# `local` is only for offline development and the automated tests against a plain PostgreSQL;
# it is refused when NODE_ENV=production.
AUTH_PROVIDER=supabase
# LOCAL_JWT_SECRET=only-needed-when-AUTH_PROVIDER=local-at-least-32-characters

# Comma-separated list of browser origins allowed to call the API (the bundled frontend is same-origin).
CORS_ORIGINS=http://localhost:4000

# Serve the frontend (../frontend) from this server.
SERVE_FRONTEND=true
FRONTEND_DIR=../frontend

# Demo mode: shows demo accounts on the sign-in page, the guided demo, demo reset and
# "play scenario". Set to false in production.
DEMO_MODE=true
DEMO_PASSWORD=TransferDemo!2026

# Intake worker: how often queued transcripts are read and evaluated (0 = disabled).
INTAKE_WORKER_INTERVAL_MS=5000
UPLOAD_MAX_MB=10
LOG_REQUESTS=true

# Transcript documents. `auto` = Supabase Storage (private bucket STORAGE_BUCKET, needs SUPABASE_SERVICE_ROLE_KEY)
# when configured, otherwise files are kept in STORAGE_LOCAL_DIR on the API server (development only).
STORAGE_PROVIDER=auto
STORAGE_BUCKET=transcripts
STORAGE_LOCAL_DIR=./storage

# OPTIONAL SERVER-SIDE SECRET. Enables the AI vision reader for scanned transcripts and photos.
# Digital PDFs and text exports are read without it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Live demos: minimum time each processing stage is shown (ms). 0 in production.
PROCESSING_STAGE_DELAY_MS=600
