# Settings for `npm test` and offline development against a local PostgreSQL (no Supabase needed).
# 1. createdb transfer   2. cp .env.test.example .env.test   3. npm run db:migrate && npm test  (with DOTENV_CONFIG_PATH=.env.test)
NODE_ENV=test
PORT=4100
DATABASE_URL=postgresql://postgres@localhost:5432/transfer
DATABASE_SSL=false
AUTH_PROVIDER=local
LOCAL_JWT_SECRET=local-development-only-secret-0123456789abcdef
DEMO_MODE=true
INTAKE_WORKER_INTERVAL_MS=0
LOG_REQUESTS=false
CORS_ORIGINS=http://localhost:4100
